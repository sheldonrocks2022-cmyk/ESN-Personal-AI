# Copy values into your hosting environment; never commit real keys.
ESN_OWNER_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
ESN_BIND=127.0.0.1
ESN_PORT=8765
ESN_DB_PATH=esn_jarvis.sqlite3
PTERO_BASE_URL=https://panel.esnoffical.com
PTERO_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Dashboard. Generate PIN hash interactively: python3 -m connections hash-pin
# IMPORTANT: never commit your real PIN hash or vault key to the public repository.
ESN_DASHBOARD_PIN_HASH=
# Generate with: python3 -m connections generate-key
ESN_VAULT_KEY=
ESN_PUBLIC_ORIGIN=https://jarvis.esnoffical.com
ESN_COOKIE_SECURE=1
# Optional Discord owner-only slash commands
DISCORD_OWNER_USER_ID=
DISCORD_CONNECTION_ID=
DISCORD_GUILD_ID=
